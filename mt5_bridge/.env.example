# ---- Supabase (from your project) ----
SUPABASE_URL=https://your-project.supabase.co

# ---- How the bridge signs in (pick ONE) ----
#
# RECOMMENDED: sign in as yourself. The anon key is public by design, and
# Supabase's row-level security then confines the bridge to your own rows —
# exactly like the web app.
SUPABASE_ANON_KEY=sb_publishable_xxx_your_anon_key
JOURNAL_EMAIL=you@example.com
JOURNAL_PASSWORD=your-journal-password

# ALTERNATIVE, single-user only: the service key bypasses row-level security
# entirely. Whoever holds it can read and modify EVERY user's trades, so never
# give it to anyone else running this bridge.
# SUPABASE_SERVICE_KEY=sb_secret_xxx_your_service_role_key
# JOURNAL_USER_ID=00000000-0000-0000-0000-000000000000

# ---- Behaviour ----
POLL_SECONDS=60
LOOKBACK_DAYS=30
# Mirror still-open positions into the journal (marked status='open', so their
# floating P&L is never counted as realised). Set to false for closed only.
SYNC_OPEN=true

# ---- Optional: explicit MT5 login (leave blank to attach to the open terminal) ----
#
# Use your INVESTOR password, not the master one. MT5 makes an investor login
# read-only at the broker: it can see balance, positions and history but cannot
# place, change or close an order. That way "this only reads" is enforced by
# the credential rather than being a promise the script makes about itself.
#
# FundingPips and most prop firms show the investor password alongside the
# master one in the account dashboard.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
