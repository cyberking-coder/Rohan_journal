# ---- Supabase (from your project) ----
SUPABASE_URL=https://your-project.supabase.co
# SERVICE key (Settings -> API -> service_role). Keep this SECRET, local only.
# Required: the economic_events table is read-only from the browser by design,
# so only the service role can write to it.
SUPABASE_SERVICE_KEY=sb_secret_xxx_your_service_role_key

# ---- Apify (only for --provider apify) ----
# https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx

# The actor publishes wall-clock times. This says what zone to read them in
# before converting to UTC. Getting it wrong shifts every release by hours, so
# check one known event against investing.com after your first import.
APIFY_CALENDAR_TZ=UTC

# Optional actor filters, passed straight through. Empty means no filter.
APIFY_TIME_FILTER=time_only
APIFY_IMPORTANCES=
APIFY_CATEGORIES=
APIFY_COUNTRY=
