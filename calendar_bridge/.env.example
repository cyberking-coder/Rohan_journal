# ---- Supabase (from your project) ----
SUPABASE_URL=https://your-project.supabase.co
# SERVICE key (Settings -> API -> service_role). Keep this SECRET, local only.
# Required: the economic_events table is read-only from the browser by design,
# so only the service role can write to it.
SUPABASE_SERVICE_KEY=sb_secret_xxx_your_service_role_key
